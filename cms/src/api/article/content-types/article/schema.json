{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": { "singularName": "article", "pluralName": "articles", "displayName": "Article", "description": "News articles" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "slug": { "type": "uid", "required": true },
    "title": { "type": "string" },
    "metaDescription": { "type": "text" },
    "h1": { "type": "string" },
    "excerpt": { "type": "text" },
    "coverImage": { "type": "string" },
    "body": { "type": "text", "maxLength": 200000 },
    "source": { "type": "enumeration", "enum": ["news", "root"], "default": "news" }
  }
}
